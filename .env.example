APP_PORT=8080
APP_ENV=development
APP_NAME=SELA Service Evidence Uploader
APPLICATION_ID=sela
PUBLIC_URL=http://localhost:8080
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgres://app:replace-with-local-password@db:5432/app?sslmode=disable&application_name=sela
SESSION_HASH_KEY=replace-with-base64-32-random-bytes
PAT_HASH_KEY=replace-with-base64-32-random-bytes
WEBHOOK_ENCRYPTION_KEY=replace-with-base64-exactly-32-random-bytes
ODOO_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-exactly-32-random-bytes
GTM_CONTAINER_ID=GTM-XXXXXXX
ENTRA_TENANT_ID=replace-with-tenant-uuid
ENTRA_CLIENT_ID=replace-with-client-uuid
ENTRA_CLIENT_SECRET=replace-with-runtime-secret
ENTRA_ISSUER=https://login.microsoftonline.com/replace-with-tenant-uuid/v2.0
ENTRA_AUTH_URL=https://login.microsoftonline.com/replace-with-tenant-uuid/oauth2/v2.0/authorize
ENTRA_TOKEN_URL=https://login.microsoftonline.com/replace-with-tenant-uuid/oauth2/v2.0/token
ENTRA_JWKS_URL=https://login.microsoftonline.com/replace-with-tenant-uuid/discovery/v2.0/keys
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=replace-with-site-key
TURNSTILE_SECRET_KEY=replace-with-runtime-secret
TURNSTILE_EXPECTED_HOSTNAMES=localhost
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
ODOO_URL=https://odoo.example.invalid
ODOO_DB=replace-with-database
SHAREPOINT_ALLOWED_HOSTS=tenant.sharepoint.com
QUARANTINE_DIR=/var/lib/sela/quarantine
# Production requires remote mode, HTTPS URL, and runtime secret.
SCANNER_MODE=development
SCANNER_URL=https://scanner.example.invalid
SCANNER_TOKEN=replace-with-runtime-secret
SCANNER_NETWORK=scanner_private
