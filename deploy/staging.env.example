# SELA staging identity configuration
APP_ENV=staging
APPLICATION_ID=sela-staging
PUBLIC_URL=https://sela.ilectraev.com
ODOO_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-exactly-32-random-bytes

# Dedicated or approved single-tenant Microsoft Entra web app.
ENTRA_TENANT_ID=replace-with-tenant-uuid
ENTRA_CLIENT_ID=replace-with-client-uuid
ENTRA_CLIENT_SECRET=replace-with-client-secret
ENTRA_ISSUER=https://login.microsoftonline.com/replace-with-tenant-uuid/v2.0
ENTRA_AUTH_URL=https://login.microsoftonline.com/replace-with-tenant-uuid/oauth2/v2.0/authorize
ENTRA_TOKEN_URL=https://login.microsoftonline.com/replace-with-tenant-uuid/oauth2/v2.0/token
ENTRA_JWKS_URL=https://login.microsoftonline.com/replace-with-tenant-uuid/discovery/v2.0/keys

# Register exact Web redirect URI in Entra:
# https://sela.ilectraev.com/auth/callback

# Temporary staging exception. Production startup rejects false.
TURNSTILE_ENABLED=false
TURNSTILE_EXPECTED_HOSTNAMES=sela.ilectraev.com
